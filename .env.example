# Copy this file to .env and fill in your own values.
# Never share your Discord token or YouTube cookie publicly.

# Discord bot token
# Find it here:
# → Discord Developer Portal https://discord.com/developers/applications
# → Open your application → Bot → Copy Token
DISCORD_TOKEN=your_discord_bot_token_here

# Discord application ID
# Find it here:
# → Discord Developer Portal https://discord.com/developers/applications
# → Open your application → General Information → Application ID
CLIENT_ID=your_client_id_here

# Discord server ID
# Find it here:
# → Enable Developer Mode in Discord Settings → Advanced
# → Right-click your server → Copy Server ID
GUILD_ID=your_server_id_here

# YouTube cookie (optional, helps play-dl resolve stream URLs)
# Find it here:
# → Open YouTube in your browser
# → Press F12 → Application tab → Cookies → youtube.com
# → Copy the values for the cookie entries you see
# Important: treat this as sensitive and do not share it publicly.
YOUTUBE_COOKIE="paste_your_youtube_cookie_here"